# expo pulls react-dom in as an optional peer, and the version it resolves
# (19.3) demands react ^19.3 while this project is pinned to the react 19.2.3
# that react-native 0.86 expects. Nothing here imports react-dom — web support
# was declared in app.json but never installed — so the strict peer algorithm
# is failing on a dependency the app does not use. Pin the resolution mode so
# local installs and CI's `npm ci` agree.
legacy-peer-deps=true
