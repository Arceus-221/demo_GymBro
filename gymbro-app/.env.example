# gymbro-app/.env.example
# Copy to .env.local (Expo's convention) and fill in real values.
# NOTE: nothing AI-related belongs here — the Gemini/OpenRouter/Groq keys
# live ONLY in gymbro-backend/.env. This file is Firebase client config only,
# which is safe to ship in the app bundle (it is not a secret the way a
# server API key is — Firestore Security Rules are the actual gatekeeper).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=gymbro-xxxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=gymbro-xxxxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=gymbro-xxxxx.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend base URL (Render). Point at a local tunnel/emulator during dev.
EXPO_PUBLIC_API_BASE_URL=https://gymbro-api.onrender.com
